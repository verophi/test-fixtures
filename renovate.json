{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "automerge": false,
  "recreateWhen": "always",
  "commitBody": "[skip ci]",
  "lockFileMaintenance": { "enabled": true, "skipArtifactsUpdate": false, "schedule": ["at any time"] },
  "skipArtifactsUpdate": true,
  "rollbackPrs": true,
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "labels": ["renovate", "{{datasource}}", "{{updateType}}"],
  "packageRules": [
    {
      "description": "Label packages not covered by Trivy SBOM scanning",
      "matchDatasources": ["github-tags", "docker"],
      "addLabels": ["no-sbom-coverage"]
    },
    {
      "description": "Disable lockFileMaintenance for everything except the dedicated fixture",
      "matchUpdateTypes": ["lockFileMaintenance"],
      "matchFileNames": ["!packages/lockfile-maintenance/**"],
      "enabled": false
    },
    { "description": "npm: lodash CVE fix (patch)", "matchPackageNames": ["lodash"], "allowedVersions": "<=4.17.21" },
    {
      "description": "CASE-PARTIAL-1: lodash-es disabled — no MR created. CVE-2021-23337 + CVE-2020-28500 affect both lodash AND lodash-es; lodash gets fixed (MR !134 target 4.17.21), lodash-es does not → partially addressed (1/2 occurrences).",
      "matchPackageNames": ["lodash-es"],
      "enabled": false
    },
    { "description": "npm: minimist CVE fix (patch)", "matchPackageNames": ["minimist"], "allowedVersions": "<=1.2.6" },
    { "description": "npm: express minor update", "matchPackageNames": ["express"], "allowedVersions": "<=4.21.0" },
    { "description": "Python: PyYAML CVE fix (major)", "matchPackageNames": ["PyYAML"], "allowedVersions": "<=6.0" },
    { "description": "Python: Pillow CVE fix (major)", "matchPackageNames": ["Pillow"], "allowedVersions": "<=10.2.0" },
    { "description": "Python: requests CVE fix (patch)", "matchPackageNames": ["requests"], "allowedVersions": "<=2.32.0" },
    { "description": "Python: python-multipart CVE fix (minor) — exercises PEP503 name normalization (hyphens/underscores)", "matchPackageNames": ["python-multipart"], "allowedVersions": "<=0.0.18" },
    { "description": "Go: x/net CVE fixes", "matchPackageNames": ["golang.org/x/net"], "allowedVersions": "<=v0.33.0" },
    { "description": "Go: x/crypto CVE fixes", "matchPackageNames": ["golang.org/x/crypto"], "allowedVersions": "<=v0.31.0" },
    { "description": "Go: gin CVE fix (minor)", "matchPackageNames": ["github.com/gin-gonic/gin"], "allowedVersions": "<=v1.9.1" },
    { "description": "Maven: log4j-core CVE fix (minor)", "matchPackageNames": ["org.apache.logging.log4j:log4j-core"], "allowedVersions": "<=2.17.1" },
    { "description": "Rust: rustls CVE fix (patch)", "matchPackageNames": ["rustls"], "allowedVersions": "<=0.21.11" },
    { "description": "Rust: tokio CVE fix (minor)", "matchPackageNames": ["tokio"], "allowedVersions": "<=1.27.0" },
    { "description": "Ruby: actionpack CVE fixes (patch)", "matchPackageNames": ["actionpack"], "allowedVersions": "<=6.1.7.8" },
    { "description": "NuGet: Newtonsoft.Json CVE fix (major)", "matchPackageNames": ["Newtonsoft.Json"], "allowedVersions": "<=13.0.3" },
    { "description": "NuGet: System.Text.Json CVE fix (major)", "matchPackageNames": ["System.Text.Json"], "allowedVersions": "<=8.0.5" },
    { "description": "PHP: guzzlehttp/guzzle CVE fixes (minor)", "matchPackageNames": ["guzzlehttp/guzzle"], "allowedVersions": "<=7.8.0" },
    { "description": "Elixir: phoenix CVE fix (minor)", "matchPackageNames": ["phoenix"], "allowedVersions": "<=1.7.0" },
    { "description": "Dart: dio CVE fix (major)", "matchPackageNames": ["dio"], "allowedVersions": "<=5.0.0" },
    {
      "description": "Swift: swift-nio-http2 CVE fix (minor). Target 1.28.0 reaches CVE-2023-44487 fix. Together with x/net MR, this makes 44487 collectively reducible across 2 MRs.",
      "matchPackageNames": ["apple/swift-nio-http2"],
      "allowedVersions": "<=1.28.0"
    },
    { "description": "Docker: nginx CVE fix (minor)", "matchPackageNames": ["nginx"], "matchDatasources": ["docker"], "allowedVersions": "<=1.25" },
    { "description": "Docker: pin node image digest (pinDigest)", "matchPackageNames": ["node"], "matchDatasources": ["docker"], "pinDigests": true },

    { "description": "CASE-GROUP-1: grouped axios + tough-cookie + semver", "groupName": "http-client-group", "matchPackageNames": ["axios", "tough-cookie", "semver"] },
    { "description": "CASE-GROUP-1: axios cap", "matchPackageNames": ["axios"], "allowedVersions": "<=0.21.4" },
    { "description": "CASE-GROUP-1: tough-cookie cap", "matchPackageNames": ["tough-cookie"], "allowedVersions": "<=4.1.3" },
    { "description": "CASE-GROUP-1: semver cap", "matchPackageNames": ["semver"], "allowedVersions": "<=7.5.2" },

    { "description": "CASE-PIN-1: json5 pin", "matchPackageNames": ["json5"], "rangeStrategy": "pin" },

    {
      "description": "CASE-SPLIT-1: lodash (patch, VIS=6) + ws (major, VIS=0) in one group. RiskTier=major, lodash is SplitCandidate with share=1.0, childVME=6.0 >> CR-VME=2.0.",
      "groupName": "split-candidate-group",
      "matchPackageNames": ["lodash", "ws"],
      "separateMajorMinor": false,
      "separateMinorPatch": false
    },

    {
      "description": "CASE-BUMP-1: chalk in-range bump. Renovate emits updateType=patch in the MR table but applies a bumped range. The addLabel 'bump' marks this MR for future parser support.",
      "matchPackageNames": ["chalk"],
      "rangeStrategy": "bump",
      "addLabels": ["bump"]
    },
    {
      "description": "CASE-BUMP-1b: cap chalk to 4.x",
      "matchPackageNames": ["chalk"],
      "allowedVersions": "<5"
    },
    {
      "description": "CASE-ROLLBACK-1: left-pad rollback -> ChangeRollback (risk 3). Declared at >=2.0.0 (no such version exists) so Renovate rolls back to 1.3.0. Requires rollbackPrs:true (set globally).",
      "matchPackageNames": ["left-pad"]
    },
    {
      "description": "CASE-REPLACEMENT-1: xmldom -> @xmldom/xmldom -> ChangeReplacement (risk 0, unknown). Exercises HasUnknownRisk / VME n/a on a parseable-version replacement.",
      "matchPackageNames": ["xmldom"],
      "matchDatasources": ["npm"],
      "replacementName": "@xmldom/xmldom",
      "replacementVersion": "0.8.10"
    }
  ]
}
